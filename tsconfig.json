{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@resell/localized",
    "baseUrl": ".",
    "paths": { "@resell/localized/*": ["web/localized/*"] },
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "native-offer/**/*.ts",
    "api/**/*.ts",
    "server.local.ts"
  ]
}
