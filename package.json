{
  "name": "resell",
  "private": true,
  "version": "1.6.48",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server.local.ts\" \"vite --config vite.config.mjs\"",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:windows": "node scripts/build-android-offer.mjs --main",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "build:native-offer": "node scripts/build-native-offer.mjs",
    "build:offer-sandbox": "npm run build:native-offer && vite build --config vite.offer-sandbox.config.mjs",
    "offer-sandbox:desktop": "tauri dev --config src-tauri/tauri.offer-sandbox.conf.json --features offer-sandbox",
    "offer-sandbox:android:init": "tauri android init --config src-tauri/tauri.offer-sandbox.conf.json",
    "offer-sandbox:android": "tauri android dev --config src-tauri/tauri.offer-sandbox.conf.json --features offer-sandbox",
    "offer-sandbox:android:build": "tauri android build --config src-tauri/tauri.offer-sandbox.conf.json --features offer-sandbox --apk",
    "offer-sandbox:android:windows": "node scripts/build-android-offer.mjs",
    "offer-sandbox:ios:init": "tauri ios init --config src-tauri/tauri.offer-sandbox.conf.json",
    "offer-sandbox:ios": "tauri ios dev --config src-tauri/tauri.offer-sandbox.conf.json --features offer-sandbox",
    "offer-sandbox:ios:build": "tauri ios build --config src-tauri/tauri.offer-sandbox.conf.json --features offer-sandbox",
    "android:release:windows": "node scripts/build-android-offer.mjs --main --release",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@vimeo/player": "^2.30.4",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vimeo__player": "^2.18.3",
    "@vercel/node": "^5.3.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
